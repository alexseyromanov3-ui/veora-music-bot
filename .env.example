# Telegram Bot Token (получить в @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# URL веб-приложения Mini App (URL фронтенда или ngrok туннеля для разработки)
WEBAPP_URL=https://your-mini-app-domain.com

# Настройки базы данных
# Для SQLite: sqlite+aiosqlite:///./musicbot.db
# Для PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/musicbot
DATABASE_URL=sqlite+aiosqlite:///./musicbot.db

# Настройки FastAPI сервера
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# Настройки директорий хранения файлов
MEDIA_DIR=./media
AUDIO_DIR=./media/audio
COVERS_DIR=./media/covers

# Максимальный размер загружаемого аудио (в байтах, по умолчанию 20 МБ)
MAX_FILE_SIZE=20971520

# Секретный ключ для подписи внутренних JWT-токенов сессий
SECRET_KEY=change_this_to_a_secure_random_string_in_production
